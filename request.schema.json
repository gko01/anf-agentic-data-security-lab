{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Policy Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "agent_id",
    "action",
    "purpose",
    "resource_path"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "resource_path": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^/vol1/Project-A/[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:txt|csv)$(?![\\s\\S])"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anf-agentic-data-security-lab:decision-schema",
  "title": "Offline Agent Policy Decision",
  "description": "Policy output. classification_metadata is explicitly a mock transcription of the 2026-10-01 UI baseline, not an API response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "reason_code",
    "reason",
    "evaluated_on",
    "request",
    "classification_metadata",
    "metadata_source",
    "metadata_is_mock"
  ],
  "properties": {
    "decision": {"type": "string", "enum": ["ALLOW", "DENY"]},
    "reason_code": {
      "type": "string",
      "enum": [
        "ALLOW",
        "INVALID_REQUEST",
        "INVALID_RESOURCE",
        "REQUEST_NOT_APPROVED",
        "PROVIDER_ERROR",
        "METADATA_MISSING",
        "METADATA_INVALID",
        "METADATA_EXPIRED",
        "CLASSIFICATION_NOT_ALLOWED"
      ]
    },
    "reason": {"type": "string", "minLength": 1},
    "evaluated_on": {"type": "string", "format": "date"},
    "request": {
      "anyOf": [
        {"$ref": "#/$defs/request"},
        {"type": "null"}
      ]
    },
    "classification_metadata": {
      "anyOf": [
        {"$ref": "#/$defs/classificationMetadata"},
        {"type": "null"}
      ]
    },
    "metadata_source": {"type": ["string", "null"]},
    "metadata_is_mock": {"type": "boolean", "const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision": {"const": "ALLOW"}},
        "required": ["decision"]
      },
      "then": {"properties": {"reason_code": {"const": "ALLOW"}}}
    },
    {
      "if": {
        "properties": {"decision": {"const": "DENY"}},
        "required": ["decision"]
      },
      "then": {"properties": {"reason_code": {"not": {"const": "ALLOW"}}}}
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "action", "purpose", "resource"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "resource": {
          "type": "string",
          "enum": [
            "/vol1/Project-A/control-clean.txt",
            "/vol1/Project-A/product-info.txt",
            "/vol1/Project-A/public-announcement.txt",
            "/vol1/Project-A/customers.csv",
            "/vol1/Project-A/employees.csv",
            "/vol1/Project-A/acquisition-plan.txt"
          ]
        }
      }
    },
    "classificationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "observed_on",
        "personal_count",
        "sensitive_personal_count",
        "data_subjects",
        "category",
        "open_permissions",
        "personal_details"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "observed_on": {"type": "string", "format": "date"},
        "personal_count": {"type": "integer", "minimum": 0},
        "sensitive_personal_count": {"type": "integer", "minimum": 0},
        "data_subjects": {"type": "integer", "minimum": 0},
        "category": {"type": "string", "minLength": 1},
        "open_permissions": {"type": "string", "minLength": 1},
        "personal_details": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
